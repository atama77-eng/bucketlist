# このファイルを .env という名前でコピーして使う（.env は Git に入れないこと）

# --- データベース ---
# ローカル開発はこのままでOK（app.db というファイルを使う）
DATABASE_URL=sqlite:///./app.db

# Neon に切り替えるとき、この行を上と入れ替える
# Neon のダッシュボード → Connection string（Pooled connection）をコピー
# DATABASE_URL=postgresql://ユーザー:パスワード@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Claude API ---
# 空のあいだは固定テンプレートで動く
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- 写真の保存先 ---
# 空のあいだは static/uploads/ に保存される
# Vercel のダッシュボード → Storage → Blob を作ると発行される
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx
